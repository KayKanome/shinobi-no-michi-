# Porta HTTP usada pelo Render para a rota de saúde
PORT=3000

# Token do bot Discord (configure somente no Render; nunca envie ao GitHub)
DISCORD_BOT_TOKEN=

# Banco PostgreSQL do Neon (mantenha como segredo no Render)
DATABASE_URL=

# Opcional: diretório para armazenamento local em testes sem DATABASE_URL
# DATA_DIR=/data
