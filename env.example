# Porta do servidor (a hospedagem geralmente define PORT automaticamente)
PORT=3000
WEBHOOK_PATH=/webhooks/whatsapp

# Crie seu próprio valor secreto e use o mesmo no painel da Meta
WHATSAPP_VERIFY_TOKEN=troque-por-um-token-secreto

# Valores fornecidos pelo painel Meta for Developers
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
META_APP_SECRET=

# Versão atual da Graph API
WHATSAPP_GRAPH_API_VERSION=v27.0

# Pasta de dados persistentes, conforme a hospedagem
# DATA_DIR=/data
